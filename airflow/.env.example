# Local Windows PostgreSQL is reached from Docker Desktop using this hostname.
# Reuse the existing postgres role; create the two databases if needed (see README.md).
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:FILL_IN_POSTGRES_PASSWORD@host.docker.internal:5432/airflow_meta
AIRFLOW_CONN_FINANCIAL_POSTGRES=postgresql://postgres:FILL_IN_POSTGRES_PASSWORD@host.docker.internal:5432/financial_data

# Optional collector settings.
COLLECTOR_POSTGRES_CONN_ID=financial_postgres
COLLECTOR_LOOKBACK_DAYS=7
COLLECTOR_HTTP_TIMEOUT_SECONDS=30
COLLECTOR_LOCAL_DATA_DIR=/opt/airflow/data/landing
# HNX_DISCLOSURE_URL=https://portal.hnx.vn/vi-vn/thong-tin-cong-bo-ny-hnx.html
# SSC_DISCLOSURE_URL=https://congbothongtin.ssc.gov.vn/
